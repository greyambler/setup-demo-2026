{
  "name": "setup-demo-2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "npx prettier --write .",
    "lint": "npx prettier --check . && npx eslint .",
    "lint:fix": "npx prettier --write . && npx eslint --fix .",
    "prepare": "husky",
    "test": "npx vitest --dom"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{js,jsx}": "npx eslint --fix",
    "*.{js,jsx,json,html,yml,css,scss,md}": "npx prettier --check"
  }
}
